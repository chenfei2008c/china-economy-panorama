[
  {
    "id": "CAL01",
    "title": "GDP名义增长、平减变化与货币增速差",
    "period": "2025全年 / 2025-12末",
    "scope": "全国GDP年度流量、M2年末存量同比；两种期间明确分开",
    "inputs": [
      {
        "metric_id": "A001",
        "name": "2025年现价GDP",
        "value": 1401879,
        "unit": "亿元",
        "source": "A_S01",
        "location": "表1全年GDP"
      },
      {
        "metric_id": "A001",
        "name": "2024年最终核实GDP",
        "value": 1348066,
        "unit": "亿元",
        "source": "A_S02",
        "location": "附件1"
      },
      {
        "metric_id": "A002",
        "name": "2025年实际GDP同比",
        "value": 5,
        "unit": "百分数",
        "source": "A_S01",
        "location": "表1"
      },
      {
        "metric_id": "A043",
        "name": "2025年12月末M2同比",
        "value": 8.5,
        "unit": "百分数",
        "source": "A_S17",
        "location": "印刷页6"
      }
    ],
    "outputs": [
      {
        "metric_id": "A012",
        "name": "名义GDP同比",
        "expression": "(x0/x1-1)*100",
        "expected": 3.991863,
        "unit": "%",
        "meaning": "同版本可比基数",
        "tolerance": 1e-05
      },
      {
        "metric_id": "A013",
        "name": "GDP平减指数变化",
        "expression": "((x0/x1)/(1+x2/100)-1)*100",
        "expected": -0.96013,
        "unit": "%",
        "meaning": "名义与实际变动的比值",
        "tolerance": 1e-05
      },
      {
        "metric_id": "A055",
        "name": "M2同比减名义GDP同比",
        "expression": "x3-(x0/x1-1)*100",
        "expected": 4.508137,
        "unit": "百分点",
        "meaning": "只描述背离，不是空转率",
        "tolerance": 1e-05
      }
    ],
    "boundary": "GDP初值会修订；年末货币与全年支出比较不识别传导效率或政策效果。"
  },
